# Copy this file to .env and fill in real values: cp .env.example .env

# --- Database (used by both the db and backend services) ---
POSTGRES_DB=timecapsule
POSTGRES_USER=timecapsule
POSTGRES_PASSWORD=change-me

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- App ---
APP_TITLE=Time Capsule
APP_PORT=8000
MAX_LOCK_DAYS=3650
