# Copy to .env and adjust: cp .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_LOG_LEVEL=INFO
# Optional admin account for /admin/ (created on first start)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@holonet.local
DJANGO_SUPERUSER_PASSWORD=change-me

# --- Database (used by both the db and api containers) ---
POSTGRES_DB=galaxy
POSTGRES_USER=galaxy
POSTGRES_PASSWORD=change-me

# --- Runtime ---
SEED_ON_STARTUP=true
GUNICORN_WORKERS=3
API_PORT=8000
ADMINER_PORT=8080
