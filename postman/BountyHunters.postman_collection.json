    {
      "name": "Hunt Logs (CRUD)",
      "item": [
        {
          "name": "List all hunt logs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"At least 10 hunt logs\", () => pm.expect(pm.response.json()).to.be.an(\"array\").with.length.at.least(10));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            }
          }
        },
        {
          "name": "Filter hunt logs by criminal_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const id = Number(pm.collectionVariables.get(\"criminal_id\"));",
                  "pm.test(\"All logs belong to criminal \" + id, () => pm.response.json().forEach(h => pm.expect(h.criminal_id).to.eql(id)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/?criminal_id={{criminal_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ],
              "query": [
                {
                  "key": "criminal_id",
                  "value": "{{criminal_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Create hunt log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const h = pm.response.json();",
                  "pm.test(\"Saved with server timestamp\", () => {",
                  "  pm.expect(h.id).to.be.a(\"number\");",
                  "  pm.expect(h.created_at).to.be.a(\"string\");",
                  "  pm.expect(h.success).to.be.false;",
                  "  pm.expect(h.notes).to.eql(\"Target escaped through an asteroid field.\");",
                  "});",
                  "pm.collectionVariables.set(\"hunt_id\", h.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": {{criminal_id}},\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create hunt log ignores client created_at",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const h = pm.response.json();",
                  "pm.test(\"created_at is set by server, not by client\", () => pm.expect(h.created_at).to.not.include(\"2000-01-01\"));",
                  "pm.collectionVariables.set(\"extra_hunt_id\", h.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
