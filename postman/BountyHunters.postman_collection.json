{
  "info": {
    "name": "Space Bounty Hunters API",
    "description": "Midterm practical assignment. Start the API with `docker compose up --build`, then Run collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Wanted Criminals",
      "item": [
        {
          "name": "List all criminals",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"Returns a list with at least 5 criminals\", () => pm.expect(list).to.be.an(\"array\").with.length.at.least(5));",
                  "pm.collectionVariables.set(\"criminal_id\", list[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ]
            }
          }
        },
        {
          "name": "Filter + sort (min_reward, armed, -reward)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"Not empty\", () => pm.expect(list.length).to.be.above(0));",
                  "pm.test(\"All rewards >= 5000 and armed\", () => list.forEach(c => {",
                  "  pm.expect(Number(c.reward)).to.be.at.least(5000);",
                  "  pm.expect(c.armed).to.be.true;",
                  "}));",
                  "pm.test(\"Sorted by reward descending\", () => {",
                  "  for (let i = 1; i < list.length; i++) pm.expect(Number(list[i - 1].reward)).to.be.at.least(Number(list[i].reward));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/?min_reward=5000&armed=true&sort=-reward",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "5000"
                },
                {
                  "key": "armed",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "-reward"
                }
              ]
            }
          }
        },
        {
          "name": "Filter by max_reward, has_crew, escape_master",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.response.json().forEach(c => pm.test(c.nickname + \" matches filters\", () => {",
                  "  pm.expect(Number(c.reward)).to.be.at.most(10000);",
                  "  pm.expect(c.has_crew).to.be.true;",
                  "  pm.expect(c.escape_master).to.be.false;",
                  "}));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/?max_reward=10000&has_crew=true&escape_master=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "max_reward",
                  "value": "10000"
                },
                {
                  "key": "has_crew",
                  "value": "true"
                },
                {
                  "key": "escape_master",
                  "value": "false"
                }
              ]
            }
          }
        },
        {
          "name": "Sort by reward ascending",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"Sorted by reward ascending\", () => {",
                  "  for (let i = 1; i < list.length; i++) pm.expect(Number(list[i - 1].reward)).to.be.at.most(Number(list[i].reward));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/?sort=reward",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "reward"
                }
              ]
            }
          }
        },
        {
          "name": "Criminal details",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test(\"Has all fields\", () => pm.expect(c).to.include.all.keys(",
                  "  \"id\", \"name\", \"nickname\", \"reward\", \"last_known_latitude\", \"last_known_longitude\",",
                  "  \"last_known_note\", \"difficulty\", \"armed\", \"has_crew\", \"escape_master\", \"hunts\"));",
                  "pm.test(\"Difficulty is 1..10\", () => pm.expect(c.difficulty).to.be.within(1, 10));",
                  "pm.test(\"Hunts belong to this criminal\", () => c.hunts.forEach(h => pm.expect(h.criminal_id).to.eql(c.id)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/{{criminal_id}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                "{{criminal_id}}",
                ""
              ]
            }
          }
        },
