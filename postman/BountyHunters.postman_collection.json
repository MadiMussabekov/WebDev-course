          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{hunt_id}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{hunt_id}}",
                ""
              ]
            }
          }
        },
